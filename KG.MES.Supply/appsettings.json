{
	"Logging":
	{
		"LogLevel":
		{
		"Default": "Information",
		"Microsoft.AspNetCore": "Warning"
		}
	},
	"ProductionApi":
	{
		"TimeoutSeconds": 30,
		"RetryCount": 3
	},
	"AllowedHosts": "*",
	"Notifications":
	{
		"ExpandByDefault":
		{
			"Danger": true,
			"Warning": false,
			"Success": false,
			"Info": false
		}
	}
}