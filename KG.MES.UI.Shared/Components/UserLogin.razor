@inject AuthService AuthService

<div class="login-container">
	<div class="login-card">
		<h2>Вход в систему</h2>

		@if (!string.IsNullOrEmpty(error))
		{
			<div class="alert alert-danger">@error</div>
		}

		<div class="mb-3">
			<label class="form-label">Email</label>
			<input type="email" @bind="email" class="form-control" placeholder="email@example.com" />
		</div>

		<div class="mb-3">
			<label class="form-label">Пароль</label>
			<input type="password" @bind="password" class="form-control" placeholder="Пароль" />
		</div>

		@if (string.IsNullOrEmpty(licenseKey))
		{
			<div class="mb-3">
				<label class="form-label">Лицензионный ключ</label>
				<input type="text" @bind="licenseKeyHandle" class="form-control" placeholder="XXXX-XXXX-XXXX-XXXX" />
			</div>
		}

		<button class="btn btn-primary w-100" @onclick="Login" disabled="@isLoading">
			@if (isLoading)
			{
				<span class="spinner-border spinner-border-sm me-2"></span>
			}
			Войти
		</button>
	</div>
</div>

@if (registrationRequired)
{
	<div class="modal fade show" style="display: block;" tabindex="-1">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Регистрация</h5>
				</div>
				<div class="modal-body">
					<p>Пользователь с email <strong>@email</strong> не найден.</p>
					<p>Хотите зарегистрироваться?</p>
				</div>
				<div class="modal-footer">
					<button class="btn btn-secondary" @onclick="CancelRegistration">Отмена</button>
					<button class="btn btn-primary" @onclick="GoToRegistration">Зарегистрироваться</button>
				</div>
			</div>
		</div>
	</div>
	<div class="modal-backdrop fade show"></div>
}

