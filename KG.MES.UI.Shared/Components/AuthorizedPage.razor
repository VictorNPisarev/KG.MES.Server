@inject NavigationManager NavManager

@if (isAuthorized == null)
{
	<div class="text-center py-5">
		<div class="spinner-border text-primary"></div>
	</div>
}
else if (isAuthorized == true)
{
	@if (Session.User != null)
	{
		<div style="position: fixed; top: 10px; right: 20px; z-index: 1000;">
			<div class="dropdown">
				<button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2"
						@onclick="() => userMenuOpen = !userMenuOpen">
					<i class="bi bi-person-circle"></i>
					<span>@Session.User.Name</span>
					<i class="bi @(userMenuOpen ? "bi-chevron-up" : "bi-chevron-down") small"></i>
				</button>

				@if (userMenuOpen)
				{
					<div class="position-absolute bg-white border rounded shadow-sm mt-1"
						style="right: 0; min-width: 220px; z-index: 1000;">
						<div class="p-3 border-bottom">
							<div class="fw-bold">@Session.User.Name</div>
							<small class="text-muted">@Session.User.Email</small>
							<div><span class="badge bg-secondary mt-1">@Session.User.RoleName</span></div>
						</div>
						<div class="p-2">
							<button class="btn btn-sm btn-outline-primary w-100 mb-1" @onclick="OpenChangePassword">
								<i class="bi bi-key me-1"></i> Сменить пароль
							</button>
							<button class="btn btn-sm btn-outline-danger w-100" @onclick="Logout">
								<i class="bi bi-box-arrow-right me-1"></i> Выйти
							</button>
						</div>
					</div>
					<div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 999;"
						@onclick="() => userMenuOpen = false"></div>
				}
			</div>
		</div>
	}

	@if (showChangePassword)
	{
		<ChangePasswordDialog OnClose="() => showChangePassword = false" />
	}
	@ChildContent
}
else
{
	@*NavManager.NavigateTo("login");*@
	<div class="text-center py-5">
		<p>Перенаправление на страницу входа...</p>
	</div>
}

@* Debug панель — убрать в продакшене *@
@if (true || (isAuthorized == true && debugInfo != null))
{
	<div style="position: fixed; bottom: 0; right: 0; background: rgba(0,0,0,0.9); color: #0f0; 
	                padding: 10px; font-size: 11px; max-width: 400px; z-index: 9999; border-radius: 8px 0 0 0;">
		<div><strong>AccessToken:</strong> <span style="word-break: break-all;">@debugInfo?.AccessToken</span></div>
		<div><strong>RefreshToken:</strong> <span style="word-break: break-all;">@debugInfo?.RefreshToken</span></div>
		<div><strong>LicenseKey:</strong> @debugInfo?.LicenseKey</div>
		<div><strong>DeviceId:</strong> @debugInfo?.DeviceId</div>
		<div><strong>ExpiresAt:</strong> @debugInfo?.ExpiresAt?.ToString("HH:mm:ss")</div>
		<div><strong>Remaining:</strong> @remainingSeconds сек</div>
		<button class="btn btn-sm btn-outline-danger mt-1" @onclick="ClearSession" style="font-size: 10px;">
			Сбросить сессию
		</button>
	</div>
}