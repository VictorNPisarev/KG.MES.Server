@if (isOpen)
{
	<div class="modal fade show" style="display: block;" tabindex="-1">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Смена пароля</h5>
					<button class="btn-close" @onclick="Close"></button>
				</div>
				<div class="modal-body">
					@if (!string.IsNullOrEmpty(_error))
					{
						<div class="alert alert-danger">@_error</div>
					}
					@if (!string.IsNullOrEmpty(_success))
					{
						<div class="alert alert-success">@_success</div>
					}

					<div class="mb-3">
						<label class="form-label">Текущий пароль</label>
						<input type="password" class="form-control" @bind="currentPassword" />
					</div>
					<div class="mb-3">
						<label class="form-label">Новый пароль</label>
						<input type="password" class="form-control" @bind="newPassword" />
					</div>
					<div class="mb-3">
						<label class="form-label">Подтвердите пароль</label>
						<input type="password" class="form-control" @bind="confirmPassword" />
					</div>
				</div>
				<div class="modal-footer">
					<button class="btn btn-secondary" @onclick="Close">Отмена</button>
					<button class="btn btn-primary" @onclick="Save" disabled="@_isLoading">
						@if (_isLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
						Сохранить
					</button>
				</div>
			</div>
		</div>
	</div>
	<div class="modal-backdrop fade show"></div>
}