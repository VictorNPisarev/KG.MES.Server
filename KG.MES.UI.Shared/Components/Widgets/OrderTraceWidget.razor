@using KG.MES.Shared.Helpers
@using KG.MES.Shared.Models.ViewModels
@using KG.MES.Shared.Services

@if (isLoading)
{
	<div class="text-center py-3">
		<div class="spinner-border spinner-border-sm text-primary" role="status"></div>
	</div>
}
else if (orderTrace?.WorkplaceTraces != null && orderTrace.WorkplaceTraces.Any())
{
	<div class="trace-panel">
		<div class="d-flex justify-content-between align-items-center mb-2">
			<h6 class="trace-title">
				@if (ShowLogs)
				{
					<button class="btn btn-sm btn-link text-secondary p-0" @onclick="OpenAllLogs"
						title="Показать все логи по заказу">
						<i class="bi bi-clock-history me-1"></i>
					</button>
				}
				@*<i class="bi bi-clock-history"></i>*@
				История производства
			</h6>
			<div class="d-flex gap-1">
				@if (EditMode)
				{
					<button class="btn btn-sm btn-link text-secondary p-0" @onclick="SaveChanges">
						<i class="bi bi-check-lg"></i>
					</button>
					<button class="btn btn-sm btn-link text-secondary p-0" @onclick="CancelEdit">
						<i class="bi bi-x-lg"></i>
					</button>
				}
				else if (CanEdit)
				{
					<button class="btn btn-sm btn-link text-secondary p-0" @onclick="EnterEditMode">
						<i class="bi bi-pencil"></i>
					</button>
				}
			</div>
		</div>
		<div>
			<table class="trace-table">
				<tbody>
					@foreach (WorkplaceTraceViewModel wp in orderTrace.WorkplaceTraces)
					{
						<tr>
							@if (ShowLogs)
							{
								<td>
									<button class="btn btn-sm btn-link text-secondary p-0"
										@onclick="() => OpenWorkplaceLogs(wp)" title="Логи участка @wp.WorkplaceName">
										<i class="bi bi-clock-history"></i>
									</button>
								</td>
							}
							<td class="trace-workplace">@wp.WorkplaceName</td>
							<td class="trace-status">
								@if (EditMode)
								{
									<div class="dropdown" style="position: relative; display: inline-block;">
										<span class="badge @BadgeHelper.GetBadgeClass(wp.Status)"
											  style="cursor: pointer;"
											  @onclick="() => ToggleDropdown(wp.WorkplaceId.ToString())">
											@wp.GetStatusText()
											<i class="bi bi-chevron-down ms-1 small"></i>
										</span>
										@if (openDropdowns.GetValueOrDefault(wp.WorkplaceId.ToString()))
										{
											<ul class="dropdown-menu show" style="position: absolute; z-index: 1000;">
												<li><a class="dropdown-item" @onclick='() => { wp.Status = "planned"; CloseDropdown(wp.WorkplaceId.ToString()); }' @onclick:preventDefault><span class="badge bg-secondary">Не определён</span></a></li>
												<li><a class="dropdown-item" @onclick='() => { wp.Status = "pending"; CloseDropdown(wp.WorkplaceId.ToString()); }' @onclick:preventDefault><span class="badge bg-warning">Ожидает</span></a></li>
												<li><a class="dropdown-item" @onclick='() => { wp.Status = "active"; CloseDropdown(wp.WorkplaceId.ToString()); }' @onclick:preventDefault><span class="badge bg-primary">В работе</span></a></li>
												<li><a class="dropdown-item" @onclick='() => { wp.Status = "completed"; CloseDropdown(wp.WorkplaceId.ToString()); }' @onclick:preventDefault><span class="badge bg-success">Завершён</span></a></li>
											</ul>
											<div class="position-fixed top-0 start-0 w-100 h-100" 
												 style="z-index: 999;" 
												 @onclick="() => CloseDropdown(wp.WorkplaceId.ToString())"></div>
										}
									</div>
								}
								else
								{
									<span class="badge @BadgeHelper.GetBadgeClass(wp.Status)">
										@wp.GetStatusText()
									</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}
else
{
	<p class="text-muted mb-0">Нет данных о прохождении заказа</p>
}
@if (CanEdit)
{
	<div class="d-flex gap-2 mt-3 pt-2 border-top">
		<button class="btn btn-sm btn-outline-complete" @onclick="CompleteOrder"
			disabled="@(isCompleting || isDeparturing)">
			@if (isCompleting)
			{
				<span class="spinner-border spinner-border-sm me-1"></span>
			}
			Готов
		</button>
		<button class="btn btn-sm btn-outline-departure" @onclick="DepartureOrder" disabled="@(isCompleting || isDeparturing)">
			@if (isDeparturing)
			{
				<span class="spinner-border spinner-border-sm me-1"></span>
			}
			Отгружен
		</button>
	</div>
}

@if (showLogs)
{
	<div class="operation-log-overlay" tabindex="0" @ref="logsOverlayRef" @onkeydown="OnLogsKeyDown">
		<div class="operation-log-panel" @onclick:stopPropagation="true">
			<div class="operation-log-header">
				<h6 class="mb-0">
					<i class="bi bi-clock-history me-1"></i>
					@if (logsFilterWorkplaceId.HasValue)
					{
						<span>Логи: @logsFilterWorkplaceName</span>
					}
					else
					{
						<span>Логи заказа @orderTrace?.OrderNumber</span>
					}
				</h6>
				<button class="btn-close" @onclick="CloseLogs"></button>
			</div>
			<div class="operation-log-body">
				@if (isLoadingLogs)
				{
					<div class="text-muted text-center py-3">
						<span class="spinner-border spinner-border-sm me-2"></span>Загрузка...
					</div>
				}
				else if (!filteredLogs.Any())
				{
					<div class="text-muted text-center py-3">Логов нет</div>
				}
				else
				{
					<table class="table table-sm table-hover mb-0">
						<thead>
							<tr>
								<th style="width:140px;">Время</th>
								<th>Участок</th>
								<th style="width:110px;">Операция</th>
								<th>Сотрудник</th>
								<th>Примечание</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var log in filteredLogs)
							{
								<tr>
									<td class="text-nowrap">@log.OperationTime.ToString("dd.MM.yyyy HH:mm")</td>
									<td>@log.WorkplaceName</td>
									<td>
										<span class="badge @(log.OperationType == "START" ? "bg-primary" : "bg-success")">
											@(log.OperationType == "START" ? "Начало" : "Завершение")
										</span>
									</td>
									<td>@(string.IsNullOrEmpty(log.UserName) ? "—" : log.UserName)</td>
									<td>@(string.IsNullOrEmpty(log.Notes) ? "—" : log.Notes)</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
		</div>
	</div>
}