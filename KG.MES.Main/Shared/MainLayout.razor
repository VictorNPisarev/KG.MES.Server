@inherits LayoutComponentBase

<div class="page">
	<aside class="sidebar">
		<div class="sidebar-brand">
			<img src="_content/KG.MES.UI.Shared/images/logo_white.png" class="sidebar-logo" />
			<span>Красная горка</span>
		</div>

		<nav class="sidebar-nav">
			<NavLink class="nav-item" href="" Match="NavLinkMatch.All">
				<i class="bi bi-clipboard-check"></i>
				<span>Заказы в производстве</span>
			</NavLink>

			<NavLink class="nav-item" href="upload">
				<i class="bi bi-bar-chart"></i>
				<span>Загрузить XML</span>
			</NavLink>

			<NavLink class="nav-item" href="create-order">
				<i class="bi bi-clipboard-check"></i>
				<span>Новый заказ</span>
			</NavLink>

			<NavLink class="nav-item" href="workplace-stats">
				<i class="bi bi-bar-chart"></i>
				<span>Статистика участков</span>
			</NavLink>

			<NavLink class="nav-item" href="admin">
				<i class="bi bi-person-gear"></i>
				<span>Администрирование</span>
			</NavLink>
		</nav>
		@* Блок пользователя внизу *@
		@if (Session.User != null)
		{
			<div class="sidebar-user position-relative">
				<button class="sidebar-user-btn w-100" @onclick="() => userMenuOpen = !userMenuOpen">
					<i class="bi bi-person-circle"></i>
					<div class="text-start">
						<div class="user-name">@Session.User.Name</div>
						<small class="user-role">@Session.User.RoleName</small>
					</div>
					<i class="bi @(userMenuOpen ? "bi-chevron-up" : "bi-chevron-down") ms-auto small"></i>
				</button>

				@if (userMenuOpen)
				{
					<div class="user-dropup">
						<div class="p-3 border-bottom">
							<div class="fw-bold">@Session.User.Name</div>
							<small class="text-muted d-block">@Session.User.Email</small>
							<span class="badge bg-secondary mt-1">@Session.User.RoleName</span>
						</div>
						<div class="p-2">
							<button class="btn btn-sm btn-outline-primary w-100 mb-1" @onclick="OpenChangePassword">
								<i class="bi bi-key me-1"></i> Сменить пароль
							</button>
							<button class="btn btn-sm btn-outline-danger w-100" @onclick="Logout">
								<i class="bi bi-box-arrow-right me-1"></i> Выйти
							</button>
						</div>
					</div>
					<div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 999;"
						 @onclick="() => userMenuOpen = false"></div>
				}
			</div>
		}
	</aside>

	<main>
		@Body
	</main>
</div>

@if (showChangePassword)
{
	<ChangePasswordDialog OnClose="() => showChangePassword = false" />
}
